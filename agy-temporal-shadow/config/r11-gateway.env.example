# Worker service only. Root directory: /agy-temporal-shadow. No live values/credentials here.
AGY_WORKER_TRANSPORT=GATEWAY_SHADOW
AGY_STAGE_ONLY=true
AGY_STATE_MODE=SHADOW_STAGING
AGY_CANONICAL_AUTHORITY=EXISTING_POSTGRES_D049
AGY_ORCHESTRATION_MODE=LEGACY
AGY_WORKER_ID=R11-STAGING
AGY_GATEWAY_URL=http://${{agy-gateway.RAILWAY_PRIVATE_DOMAIN}}:8080
AGY_GATEWAY_STATE_DIR=/data/r11-gateway
# First-use provisioning only, on a new empty approved directory with this env:
# node dist/src/gateway-shadow/init-journal.js
# Never auto-initialize on restart. Missing state blocks before any HTTP.
AGY_GATEWAY_LEASE_SECONDS=120
AGY_GATEWAY_TIMEOUT_MS=5000
AGY_RUNTIME_HEARTBEAT_MS=5000
AGY_RUNTIME_POLL_MS=1000
# Required: private origin of an already verified R11 HTTP connector; no path/query.
AGY_R11_CONNECTOR_URL=http://r11-connector.railway.internal:8080
# Replace with capabilities actually verified on that connector.
AGY_R11_CAPABILITIES_JSON=["text"]
# Optional AGY_R11_CONNECTOR_TOKEN: use an existing secret-store binding, never put its value here.
# DATABASE_URL and all SUPABASE_* variables must be absent on the worker.
