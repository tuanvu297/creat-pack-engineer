# Local synthetic shadow only. Secrets/real auth stay in the existing secret store.
AGY_STAGE_ONLY=true
AGY_ORCHESTRATION_MODE=LEGACY
TEMPORAL_ADDRESS=127.0.0.1:7238
TEMPORAL_NAMESPACE=agy-local
TEMPORAL_TASK_QUEUE=agy-control-shadow-v1
AGY_TEMPORAL_GATEWAY_PORT=8798
# DATABASE_URL: existing staging runtime role, NOSUPERUSER NOBYPASSRLS.
# AGY_IDENTITIES_JSON: existing scoped operator/reviewer identities, injected externally.
# No credentials are committed here. Do not point tests at production.
