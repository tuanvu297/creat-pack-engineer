+  }
+
+  function stop(): CallbackDriverState {
+    if (timer) { clearInterval(timer); timer = undefined; }
+    if (state === 'RUNNING') { state = 'STOPPED'; log('CALLBACK_DRIVER_STOPPED', {}); }
+    return state;
+  }
+
+  return { start, stop, tick, state: () => state };
+}
